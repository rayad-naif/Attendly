# Public URL of this app (no trailing slash). On Vercel this defaults to the production domain.
BASE_URL=https://attendance.example.com
APP_NAME=Attendly
# 32+ random characters. Signs sessions and encrypts stored OAuth tokens: never change it after launch.
SESSION_SECRET=
# Vercel Cron sends this as a Bearer token to /api/cron/run.
CRON_SECRET=
MONGODB_URI=
MONGODB_DB=Attendly

# HighLevel Marketplace app (Target: Sub-Account)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Advanced Settings > Auth > Shared Secret (for the custom page SSO)
GHL_SSO_KEY=
# Only needed for agency bulk installs (to mint sub-account tokens)
GHL_APP_ID=
# Optional overrides
# GHL_WEBHOOK_PUBLIC_KEY=
# GHL_WEBHOOK_ED25519_KEY=

# Zoom (General app, user-managed OAuth)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Microsoft Teams (Entra ID app registration, multitenant)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# Google Meet (Google Cloud OAuth client, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meeting notes (Google Gemini API, from Google AI Studio). Without a key, notes contain attendance only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Public pages (support, privacy, terms)
SUPPORT_EMAIL=malikrayad110@gmail.com
LEGAL_NAME=Attendly
# MARKETPLACE_URL=
# NOTE_MAX_CHARS=4000
